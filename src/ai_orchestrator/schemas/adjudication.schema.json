{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-orchestrator.dev/schemas/adjudication.schema.json",
  "title": "Adjudication",
  "description": "Decision on whether an implementation passes review, needs rework, or should be replanned.",
  "type": "object",
  "required": ["adjudication_id", "verdict", "reasoning"],
  "additionalProperties": false,
  "properties": {
    "adjudication_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
      "description": "UUID v4 identifier for this adjudication."
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "REWORK", "REPLAN", "FAIL"],
      "description": "The adjudicator's decision."
    },
    "reasoning": {
      "type": "string",
      "minLength": 1,
      "description": "Explanation of why this verdict was chosen."
    },
    "rework_steps": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "description": "Step numbers that need rework. Required if verdict is REWORK."
    },
    "rework_feedback": {
      "type": "string",
      "description": "Guidance for the rework. Required if verdict is REWORK."
    },
    "replan_feedback": {
      "type": "string",
      "description": "Guidance for replanning. Required if verdict is REPLAN."
    },
    "failure_reason": {
      "type": "string",
      "description": "Why this failure is unrecoverable. Required if verdict is FAIL."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": { "const": "REWORK" }
        }
      },
      "then": {
        "required": ["adjudication_id", "verdict", "reasoning", "rework_steps", "rework_feedback"],
        "properties": {
          "rework_steps": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": { "const": "REPLAN" }
        }
      },
      "then": {
        "required": ["adjudication_id", "verdict", "reasoning", "replan_feedback"]
      }
    },
    {
      "if": {
        "properties": {
          "verdict": { "const": "FAIL" }
        }
      },
      "then": {
        "required": ["adjudication_id", "verdict", "reasoning", "failure_reason"]
      }
    }
  ]
}
